package ui

import (
  "strconv"

  "github.com/lukasbarti/musixx/internal/library"
  "github.com/lukasbarti/musixx/web/components"
)

type LibraryTab string

const (
  LibraryTabTracks    LibraryTab = "tracks"
  LibraryTabPlaylists LibraryTab = "playlists"
)

type PlaylistFormData struct {
  Name        string
  Description string
}

type LibraryPageData struct {
  Tracks         []library.Track
  Playlists      []library.Playlist
  ActiveTab      LibraryTab
  PlaylistForm   PlaylistFormData
  PlaylistErrors []string
  TrackErrors    []string
}

templ LibraryPage(data LibraryPageData) {
  @components.Layout("Library", LibraryContent(data))
}

templ LibraryContent(data LibraryPageData) {
  if data.ActiveTab == LibraryTabPlaylists {
    @LibraryPlaylistsPane(data.Playlists, data.PlaylistForm, data.PlaylistErrors)
  } else {
    @LibraryTracksPane(data.Tracks, data.Playlists, data.TrackErrors)
  }
}

templ LibraryTracksPane(tracks []library.Track, playlists []library.Playlist, errors []string) {
  <div class="wa-stack">
    <div class="wa-split">
      <h2 class="pane-title">All Tracks</h2>
      <wa-button href="/tracks/new" variant="brand">Add Track</wa-button>
    </div>
    @formErrors("Unable to add track to playlist:", errors)
    if len(tracks) == 0 {
      <p>No tracks yet. Use the <a href="/tracks/new">Add Track</a> button to import music.</p>
    } else {
      <div class="table-scroll">
        <table class="data-table">
          <thead>
            <tr>
              <th>Play</th>
              <th>Title</th>
              <th class="col-artist">Artist</th>
              <th class="col-album">Album</th>
              <th class="col-added">Added</th>
              <th class="col-actions">Actions</th>
            </tr>
          </thead>
          <tbody>
            for _, track := range tracks {
              <tr>
                <td>
                  @TrackControls(track, "library-default")
                </td>
                <td><a href={ templ.SafeURL("/tracks/" + strconv.FormatInt(track.ID, 10) + "/edit") }><strong>{ track.Title }</strong></a></td>
                <td class="col-artist">
                  if track.Artist != nil {
                    { *track.Artist }
                  } else {
                    <span class="muted">—</span>
                  }
                </td>
                <td class="col-album">
                  if track.Album != nil {
                    { *track.Album }
                  } else {
                    <span class="muted">—</span>
                  }
                </td>
                <td class="col-added nowrap muted">{ track.CreatedAt.Format("2006-01-02") }</td>
                <td class="col-actions">
                  <div class="row-actions">
                    if len(playlists) > 0 {
                      <form method="post" action="/playlists/tracks" class="wa-cluster add-to-playlist">
                        <input type="hidden" name="track_id" value={ strconv.FormatInt(track.ID, 10) } />
                        <wa-select name="playlist_id" required placeholder="Add to playlist…" size="small">
                          for _, playlist := range playlists {
                            <wa-option value={ strconv.FormatInt(playlist.ID, 10) }>{ playlist.Name }</wa-option>
                          }
                        </wa-select>
                        <wa-button type="submit" variant="success" size="small">Add</wa-button>
                      </form>
                    }
                    <form method="post" action={ "/tracks/" + strconv.FormatInt(track.ID, 10) + "/delete" }>
                      <wa-button type="submit" variant="danger" size="small">Delete</wa-button>
                    </form>
                  </div>
                </td>
              </tr>
            }
          </tbody>
        </table>
      </div>
    }
  </div>
}

templ LibraryPlaylistsPane(playlists []library.Playlist, form PlaylistFormData, errors []string) {
  <div class="wa-stack">
    <wa-card class="page-card">
      <h2 slot="header">Create Playlist</h2>
      @formErrors("Unable to create playlist:", errors)
      <form method="post" action="/playlists" class="wa-stack">
        <wa-input label="Name" name="name" required value={ form.Name }></wa-input>
        <wa-textarea label="Description" name="description" rows="3" placeholder="What's the vibe?" value={ form.Description }></wa-textarea>
        <div class="wa-cluster">
          <wa-button type="submit" variant="brand">Save Playlist</wa-button>
          <wa-button href="/?tab=playlists">Cancel</wa-button>
        </div>
      </form>
    </wa-card>
    <wa-card class="page-card">
      <h2 slot="header">Saved Playlists</h2>
      if len(playlists) == 0 {
        <p class="muted">No playlists yet. Create your first playlist above.</p>
      } else {
        <div class="table-scroll">
          <table class="data-table">
            <thead>
              <tr>
                <th>Name</th>
                <th class="col-artist">Description</th>
                <th class="col-added">Created</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              for _, playlist := range playlists {
                <tr>
                  <td><strong>{ playlist.Name }</strong></td>
                  <td class="col-artist">
                    if playlist.Description != nil && *playlist.Description != "" {
                      { *playlist.Description }
                    } else {
                      <span class="muted">No description</span>
                    }
                  </td>
                  <td class="col-added nowrap muted">{ playlist.CreatedAt.Format("2006-01-02") }</td>
                  <td><wa-button href={ "/playlists/" + strconv.FormatInt(playlist.ID, 10) } size="small">Open</wa-button></td>
                </tr>
              }
            </tbody>
          </table>
        </div>
      }
    </wa-card>
  </div>
}
