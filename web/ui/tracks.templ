package ui

import (
  "strconv"

  "github.com/lukasbarti/musixx/internal/library"
  "github.com/lukasbarti/musixx/web/components"
)

func derefString(s *string) string {
  if s != nil {
    return *s
  }
  return ""
}

func durationAttr(d *int) string {
  if d != nil {
    return strconv.Itoa(*d)
  }
  return ""
}

// Play / queue controls for one track. The data-* attributes are the contract with
// controller.ts (see PLAY_BUTTON_SELECTOR / QUEUE_ADD_SELECTOR in constants.ts).
templ TrackControls(track library.Track, queueGroup string) {
  <div class="track-controls">
    <wa-button
      type="button"
      size="small"
      variant="brand"
      aria-label={ "Play " + track.Title }
      data-action="play-track"
      data-queue-group={ queueGroup }
      data-track-id={ strconv.FormatInt(track.ID, 10) }
      data-track-url={ "/media/" + strconv.FormatInt(track.ID, 10) }
      data-track-title={ track.Title }
      data-track-artist={ derefString(track.Artist) }
      data-track-album={ derefString(track.Album) }
      data-track-duration={ durationAttr(track.DurationSeconds) }
    >
      <wa-icon name="play"></wa-icon>
    </wa-button>
    <wa-button
      type="button"
      size="small"
      aria-label={ "Add " + track.Title + " to queue" }
      data-action="queue-track"
      data-queue-group={ queueGroup }
      data-track-id={ strconv.FormatInt(track.ID, 10) }
      data-track-url={ "/media/" + strconv.FormatInt(track.ID, 10) }
      data-track-title={ track.Title }
      data-track-artist={ derefString(track.Artist) }
      data-track-album={ derefString(track.Album) }
      data-track-duration={ durationAttr(track.DurationSeconds) }
    >+Queue</wa-button>
  </div>
}

type TrackFormData struct {
  Title     string
  Artist    string
  Album     string
  Duration  string
  FilePath  string
  SourceURL string
}

templ TrackFormPage(form TrackFormData, errors []string) {
  @components.Layout("Add Track", TrackFormContent(form, errors))
}

templ formErrors(heading string, errors []string) {
  if len(errors) > 0 {
    <wa-callout variant="danger">
      <strong>{ heading }</strong>
      <ul class="error-list">
        for _, err := range errors {
          <li>{ err }</li>
        }
      </ul>
    </wa-callout>
  }
}

templ TrackFormContent(form TrackFormData, errors []string) {
  <wa-card class="page-card">
    <h2 slot="header">Add Track</h2>
    <p class="muted">Provide metadata and either a local Opus file path or a source URL for yt-dlp to download.</p>
    @formErrors("Unable to save track:", errors)
    <form method="post" action="/tracks/new" class="wa-stack">
      <div class="form-grid">
        <wa-input label="Title" name="title" required value={ form.Title }></wa-input>
        <wa-input label="Artist" name="artist" value={ form.Artist }></wa-input>
        <wa-input label="Album" name="album" value={ form.Album }></wa-input>
        <wa-input label="Duration (seconds)" type="number" min="0" name="duration_seconds" value={ form.Duration }></wa-input>
      </div>
      <wa-input label="File Path" name="file_path" value={ form.FilePath } placeholder="music/example.opus"></wa-input>
      <wa-input label="Source URL" type="url" name="source_url" value={ form.SourceURL } placeholder="https://www.youtube.com/watch?v=..."></wa-input>
      <div class="wa-cluster">
        <wa-button type="submit" variant="brand">Save Track</wa-button>
        <wa-button href="/">Cancel</wa-button>
      </div>
    </form>
  </wa-card>
}

templ TrackEditPage(id int64, form TrackFormData, errors []string) {
  @components.Layout("Edit Track", TrackEditContent(id, form, errors))
}

templ TrackEditContent(id int64, form TrackFormData, errors []string) {
  <wa-card class="page-card">
    <h2 slot="header">Edit Track</h2>
    <p class="muted">Update the metadata associated with this track.</p>
    @formErrors("Unable to update track:", errors)
    <form method="post" action={ "/tracks/" + strconv.FormatInt(id, 10) + "/edit" } class="wa-stack">
      <div class="form-grid">
        <wa-input label="Title" name="title" required value={ form.Title }></wa-input>
        <wa-input label="Artist" name="artist" value={ form.Artist }></wa-input>
        <wa-input label="Album" name="album" value={ form.Album }></wa-input>
        <wa-input label="Duration (seconds)" type="number" min="0" name="duration_seconds" value={ form.Duration }></wa-input>
      </div>
      <wa-input label="File Path" name="file_path" value={ form.FilePath } readonly></wa-input>
      <wa-input label="Source URL" type="url" name="source_url" value={ form.SourceURL }></wa-input>
      <div class="wa-cluster">
        <wa-button type="submit" variant="brand">Update Track</wa-button>
        <wa-button href="/">Cancel</wa-button>
      </div>
    </form>
  </wa-card>
}
